---
import FutureLink from "./FutureLink.astro";
import { contacts, SOON } from "../data/clinic";
const year = 2026;
---
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a class="footer__logo" href="#top" aria-label="Doladu Clinic, на початок сторінки">
        <img src="/images/doladu-logo.webp" width="400" height="80" alt="Doladu Clinic" loading="lazy" />
      </a>
      <p class="footer__slogan" data-rec="R-014">Хірургія для кожного</p>
    </div>
    <nav class="footer__col" aria-label="Розділи сторінки">
      <ul>
        <li><a href="#directions">Напрями</a></li>
        <li><a href="#prices">Ціни</a></li>
        <li><a href="#doctors">Лікарі</a></li>
        <li><a href="#contacts">Контакти</a></li>
      </ul>
    </nav>
    <ul class="footer__col">
      <li><a href={contacts.phoneMain.href}>{contacts.phoneMain.display}</a></li>
      <li><a href={contacts.phoneSecond.href}>{contacts.phoneSecond.display}</a></li>
      <li><a href={contacts.email.href}>{contacts.email.display}</a></li>
      <li>{contacts.street}, {contacts.city}</li>
    </ul>
    <ul class="footer__col" data-rec="R-007">
      <li><a href={contacts.instagram} target="_blank" rel="noopener">Instagram</a></li>
      <li><a href={contacts.tiktok} target="_blank" rel="noopener">TikTok</a></li>
    </ul>
  </div>
  <div class="container footer__legal">
    <p>© {year} Doladu Clinic</p>
    <FutureLink note={SOON}>Політика конфіденційності</FutureLink>
    <FutureLink note={SOON}>Згода на обробку даних</FutureLink>
  </div>
</footer>
